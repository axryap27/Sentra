{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Sentra",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--disable-extensions",
                "${workspaceFolder}/test_files"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "preLaunchTask": "sentra: build"
        }
    ]
}
