{
  "name": "sentra",
  "displayName": "Sentra",
  "description": "Real-time, fully local security vulnerability scanner for 10 languages (tree-sitter + Random Forest).",
  "version": "0.3.0",
  "publisher": "aaryapatel",
  "license": "MIT",
  "author": "Aarya Patel",
  "repository": {
    "type": "git",
    "url": "https://github.com/axryap27/sentra"
  },
  "bugs": {
    "url": "https://github.com/axryap27/sentra/issues"
  },
  "homepage": "https://github.com/axryap27/sentra#readme",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "sast",
    "vulnerability",
    "static analysis",
    "cwe",
    "owasp",
    "sarif",
    "tree-sitter"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:go",
    "onLanguage:php",
    "onLanguage:csharp",
    "onLanguage:rust"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sentra.scanFile",
        "title": "Scan File for Vulnerabilities",
        "category": "Sentra"
      },
      {
        "command": "sentra.scanWorkspace",
        "title": "Scan Workspace for Vulnerabilities",
        "category": "Sentra"
      },
      {
        "command": "sentra.clearDiagnostics",
        "title": "Clear Security Diagnostics",
        "category": "Sentra"
      },
      {
        "command": "sentra.showReport",
        "title": "Show Security Report",
        "category": "Sentra"
      },
      {
        "command": "sentra.showLog",
        "title": "Show Log",
        "category": "Sentra"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId =~ /^(python|javascript|javascriptreact|typescript|typescriptreact|java|c|cpp|go|php|csharp|rust)$/",
          "command": "sentra.scanFile",
          "group": "sentra@1"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname =~ /^\\.(py|js|jsx|mjs|cjs|ts|tsx|java|c|h|cpp|cc|cxx|hpp|go|php|cs|rs)$/",
          "command": "sentra.scanFile",
          "group": "sentra@1"
        }
      ]
    },
    "configuration": {
      "title": "Sentra",
      "properties": {
        "sentra.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Sentra."
        },
        "sentra.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Scan files when they are opened or saved."
        },
        "sentra.severityLevel": {
          "type": "string",
          "enum": [
            "High",
            "Medium",
            "Low"
          ],
          "default": "Medium",
          "description": "Minimum severity level to report."
        },
        "sentra.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/test/**",
            "**/tests/**",
            "**/__pycache__/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/vendor/**",
            "**/target/**"
          ],
          "description": "Glob patterns of files to exclude from scanning (applies to every scan, not just workspace scans)."
        },
        "sentra.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Sentra's status in the status bar."
        },
        "sentra.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum file size in bytes to analyze (default 1 MB)."
        },
        "sentra.enableIncrementalScanning": {
          "type": "boolean",
          "default": true,
          "description": "Cache results by content hash and skip unchanged files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "ovsx": "1.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
